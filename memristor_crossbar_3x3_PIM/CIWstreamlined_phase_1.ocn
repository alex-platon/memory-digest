

simulator('spectre)
design("memory_manualSim" "memristor_crossbar_3x3_PIM" "schematic")
resultsDir("/afs/andrew.cmu.edu/usr14/aplanton/virtuoso/memory_manualSim/memristor_crossbar_3x3_PIM/script_files")
path(
"/afs/ece.cmu.edu/class/ece622/cad_setup/gpdk045_v_2_0/models/spectre" 
